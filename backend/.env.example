APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# hs256 = legacy shared secret. jwks = newer asymmetric keys (ES256/RS256).
AUTH_MODE=hs256
SUPABASE_JWT_SECRET=your-jwt-secret-here
# Only for AUTH_MODE=jwks, e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional, e.g. https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Rotation: put the NEW key above, move the previous key(s) here (comma separated).
FIELD_ENCRYPTION_OLD_KEYS=

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Apply Postgres RLS per request. Keep true outside local debugging.
RLS_ENFORCED=true
# off | warn | strict (strict = refuse to boot if ORM and DB columns differ)
SCHEMA_CHECK_MODE=warn

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPORT_PER_HOUR=5
RATE_LIMIT_INSIGHTS_REFRESH_PER_HOUR=10
