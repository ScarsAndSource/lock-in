# Copy to .env and fill in with your actual Supabase project's values.
# Never commit the real .env file.

APP_ENV=development

# Supabase project settings -> Database -> Connection string (URI, "Session
# pooler" or direct connection both work; if you're on the "Transaction
# pooler" instead, note the statement_cache_size=0 workaround already
# applied in app/db.py — it's required either way, doesn't hurt on direct
# connections).
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project settings -> API -> JWT Settings -> JWT Secret.
# IMPORTANT: this assumes your project uses the legacy shared-secret
# (HS256) JWT signing scheme. If your project shows "JWKS URL" instead of
# a JWT secret in that settings page, it's on the newer asymmetric scheme
# and app/security.py's decode_supabase_jwt needs to switch to JWKS-based
# verification — this was flagged, not silently assumed, in app/config.py.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this somewhere durable outside of .env too (a password manager) --
# losing it makes every encrypted journal/urge entry permanently
# undecryptable, not just inaccessible from this one deployment.
FIELD_ENCRYPTION_KEY=

CORS_ALLOW_ORIGINS=["http://localhost:5173"]
