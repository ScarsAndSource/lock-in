# ============================================================================
# PRODUCTION CHECKLIST (the defaults below are for local development)
#   APP_ENV=production
#   DATABASE_URL        your Supabase Postgres URL (pooler URL if your host needs IPv4)
#   SUPABASE_JWT_SECRET (or AUTH_MODE=jwks + SUPABASE_JWKS_URL) from Supabase -> Settings -> API
#   FIELD_ENCRYPTION_KEY  generate once and NEVER lose it: journals/urge notes/chats cannot be decrypted without it
#   CORS_ALLOW_ORIGINS  the exact URL of the deployed frontend, e.g. ["https://lockin.example.com"] (no trailing slash)
#   RLS_ENFORCED=true, SCHEMA_CHECK_MODE=warn (switch to strict once the migrations are applied)
#   Run every file in migrations/ in order (001 -> 028) in the Supabase SQL editor before the first boot.
#   REDIS_URL           Render Key Value or Upstash (in the same region as the API). With APP_ENV=production the app
#                       refuses to boot without it (or without ALLOW_NO_REDIS=true), with RATE_LIMIT_ENABLED=false, or
#                       with a localhost CORS origin.
#   TRUSTED_PROXY_HOPS  1 on Render; 2 if Cloudflare sits in front of Render. Wrong = every user shares one IP limit.
#   Schedule: python -m app.jobs.prune_ai_security_events (daily)
# ============================================================================
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# hs256 = legacy shared secret. jwks = newer asymmetric keys (ES256/RS256).
AUTH_MODE=hs256
SUPABASE_JWT_SECRET=your-jwt-secret-here
# Only for AUTH_MODE=jwks, e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional, e.g. https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Rotation: put the NEW key above, move the previous key(s) here (comma separated).
FIELD_ENCRYPTION_OLD_KEYS=

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Apply Postgres RLS per request. Keep true outside local debugging.
RLS_ENFORCED=true
# off | warn | strict (strict = refuse to boot if ORM and DB columns differ)
SCHEMA_CHECK_MODE=warn

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPORT_PER_HOUR=5
RATE_LIMIT_INSIGHTS_REFRESH_PER_HOUR=10

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_RETRIES=0
LLM_DAILY_CALL_CAP=80
RATE_LIMIT_CHAT_PER_MINUTE=6
RATE_LIMIT_CHAT_PER_HOUR=60
CHAT_RETENTION_DAYS=90

# --- tasks, reminders, nudges (slice 11) ------------------------------------
RATE_LIMIT_CAPTURE_PER_MINUTE=10
RATE_LIMIT_PUSH_TEST_PER_HOUR=6
# Web push. Generate once with:  python -m app.jobs.gen_vapid   (leave empty to run without push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE=

# --- Redis: shared rate limits, locks, idempotency, card nonces, kill-switch, breaker, strikes ---------------------
# Empty = everything runs per-process and resets on restart (fine locally). Treat Redis as a cache: no persistence needed.
# Use rediss:// (TLS) for a public endpoint. Keep it in the same region as the API: the client times out after 150 ms.
REDIS_URL=
ALLOW_NO_REDIS=false
CHAT_INFLIGHT_LOCK_SECONDS=40
IDEMPOTENCY_TTL_SECONDS=120

# --- database pool + model concurrency ------------------------------------------------------------------------
# A request holds its DB connection while the model answers, so these are the real concurrency ceiling.
# Check your Supabase plan's connection limit before raising the pool.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT_SECONDS=5
# AI_MAX_CONCURRENT=6
# AI_SLOT_WAIT_SECONDS=3

# --- client IP behind a proxy ---------------------------------------------------------------------------------
# TRUSTED_PROXY_HOPS=1

# --- global AI ceiling (all users, per UTC day; 0 = off). See: python -m app.jobs.llm_usage_report --------------
# AI_GLOBAL_DAILY_CALLS=0
# AI_GLOBAL_DAILY_TOKENS=0
# AI_GLOBAL_TRIP_FRACTION=0.9

# --- abuse strikes + audit trail (AI features only) -----------------------------------------------------------
# STRIKE_WINDOW_SECONDS=86400
# STRIKE_SOFT_THRESHOLD=4
# STRIKE_HARD_THRESHOLD=8
# STRIKE_HALVE_SECONDS=3600
# STRIKE_BAN_FIRST_SECONDS=3600
# STRIKE_BAN_REPEAT_SECONDS=86400
# STRIKE_OFFENSE_MEMORY_SECONDS=604800
# STRIKE_REVIEW_OFFENSES=3
# STRIKE_STORM_THRESHOLD=10
# STRIKE_STORM_WINDOW_SECONDS=60
# AI_EVENT_RETENTION_DAYS=30

# --- agent auto-apply ceilings + image size (batch 5) ----------------------------------------------------------
# Writes the chat agent makes without asking, per person. Past the ceiling an action waits for a tap. 0 = off.
# AUTOAPPLY_PER_DAY=60
# AUTOAPPLY_PER_MINUTE=10
# Width x height read from the image header (nothing is decoded). Groq's vision limit is higher; stay under it.
# MAX_IMAGE_PIXELS=25000000
