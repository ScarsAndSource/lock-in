# Lock'in Weave frontend (these are baked in at BUILD time; set them in your host's build environment)
# URL of the deployed FastAPI backend, no trailing slash. Required in production.
VITE_API_BASE_URL=http://localhost:8000
# Supabase project URL and the public anon key (Settings -> API). The anon key is meant to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
